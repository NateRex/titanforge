PROJECT_NAME           = "TitanForge"
PROJECT_BRIEF          = ""
PROJECT_LOGO           = images/logo_small.png

OUTPUT_DIRECTORY       = .build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = README.md \
                         packages/common/include \
                         packages/graphics/include \
                         packages/math/include
FILE_PATTERNS          = *.h *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
JAVADOC_AUTOBRIEF      = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = tfdoxygen.css
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 320
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
